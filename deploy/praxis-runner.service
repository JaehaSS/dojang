[Unit]
Description=Praxis Always-On Assistant & Remote Task Runner
After=network-online.target tailscaled.service

[Service]
Type=simple
ExecStart=%h/.local/bin/praxis-runner
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/praxis %h/.config/praxis %h/work %h/study %h/Documents

[Install]
WantedBy=default.target
